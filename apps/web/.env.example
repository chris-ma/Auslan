# Copy to .env.local and fill in values

# Signaling server URL (Phase 2 video call)
# Default: http://localhost:3001 (local dev)
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# TURN server for WebRTC NAT traversal (required for ~15-20% of connections)
# Get credentials from Twilio (free tier) or self-host coturn
NEXT_PUBLIC_TURN_URL=turn:your-turn-server.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=your_turn_username
NEXT_PUBLIC_TURN_CREDENTIAL=your_turn_credential
